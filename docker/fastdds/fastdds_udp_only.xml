<?xml version="1.0" encoding="UTF-8"?>
<!--
  R3X container-to-container DDS profile for the Pi 5 runtime.

  Fast RTPS 2.6 (the ROS 2 Humble runtime on the Pi) uses the
  FASTRTPS_DEFAULT_PROFILES_FILE environment variable.  This profile
  deliberately disables the builtin transports and enables only UDPv4.
  Keep loopback together with the Pi address: both are needed when the
  host-networked containers communicate on one host.
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>r3x_udpv4</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList>
        <address>127.0.0.1</address>
        <address>192.168.123.32</address>
      </interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>

  <participant profile_name="r3x_udp_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>r3x_udpv4</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
